# Force HTTPS and remove www.
RewriteEngine On
RewriteCond %{HTTPS} !=on [OR]
RewriteCond %{HTTP_HOST} ^www\.dieselhub\.com\.ua$ [NC]
RewriteRule ^ https://dieselhub.com.ua%{REQUEST_URI} [L,R=301]

# Link-preview and search crawlers receive server-rendered product metadata.
# Regular visitors continue to the SPA product page below.
RewriteCond %{HTTP_USER_AGENT} (facebookexternalhit|Facebot|Twitterbot|LinkedInBot|TelegramBot|WhatsApp|Viber|Discordbot|Slackbot|SkypeUriPreview|Applebot|Googlebot|bingbot|Pinterestbot) [NC]
RewriteRule ^product/([^/]+)/?$ https://diesel-api.onrender.com/share/product/$1 [R=302,L,NE]

# Serve real files and route application URLs (for example /product/0445110110)
# through the SPA entry point.
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]
RewriteRule ^ index.html [L]

<IfModule mod_headers.c>
  <FilesMatch "\.(js|css|woff2?|eot)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(jpg|jpeg|png|gif|webp|avif|svg|ico)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
  <FilesMatch "^index\.html$">
    Header set Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </FilesMatch>
  <FilesMatch "^(robots\.txt|sitemap\.xml)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>
